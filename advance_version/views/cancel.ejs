<%- include('partials/header') %>

  <main class="page">
<% if (cancellable) { %>
    <section class="booking-form">
      <h2>Cancel Appointment</h2>

      <p><strong>Patient:</strong> <%= booking.patient_name %></p>
      <p><strong>Doctor:</strong> <%= booking.doctor %></p>
      <p><strong>Date and time:</strong>
        <%= dateTimeLabel(booking.slot_start) %>
      </p>
      <p>Are you sure you want to cancel this appointment?</p>

<% if (error !== '') { %>
      <p class="form-msg error"><%= error %></p>
<% } %>

      <form method="post" action="/cancel">
        <input type="hidden" name="id" value="<%= booking.id %>">
        <input type="hidden" name="action" value="cancel">
        <input type="hidden" name="csrf" value="<%= csrfToken %>">
        <button type="submit">Cancel Appointment</button>
      </form>

      <p><a href="/my-appointments">Keep this appointment</a></p>
    </section>
<% } else { %>
    <section class="booking-form">
      <h2>Cancel Appointment</h2>
      <p class="form-msg error"><%= error %></p>
      <p><a href="/my-appointments">Back to My Appointments</a></p>
    </section>
<% } %>
  </main>

<%- include('partials/footer') %>
